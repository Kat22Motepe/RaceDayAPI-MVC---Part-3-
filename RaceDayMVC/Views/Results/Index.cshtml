@model List<RaceDay.MVC.ViewModels.EventListViewModel>
@{
    ViewData["Title"] = "Capture Results";
}

<div class="container mt-4">
    <h1>Capture Results</h1>
    <p class="text-muted">Select an event to enter participant finish times and positions.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="list-group mt-4">
        @foreach (var ev in Model)
        {
            <a asp-action="Capture" asp-route-id="@ev.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">@ev.Name</h5>
                    <small class="text-muted">@ev.EventDate.ToString("dd MMM yyyy") - @ev.Location</small>
                </div>
                <span class="badge bg-primary rounded-pill">Enter Results &rarr;</span>
            </a>
        }
    </div>
</div>