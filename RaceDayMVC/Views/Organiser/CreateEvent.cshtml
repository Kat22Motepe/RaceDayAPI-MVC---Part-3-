@using RaceDay.MVC.ViewModels
@model RaceDay.MVC.ViewModels.CreateEventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">
    <h2>Create New Event</h2>
    <hr />
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Name" class="form-label">Event Name</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EventDate" class="form-label">Date & Time</label>
                <input asp-for="EventDate" type="datetime-local" class="form-control" required />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Location" class="form-label">Location</label>
                <input asp-for="Location" class="form-control" required />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="DistanceKm" class="form-label">Distance (km)</label>
                <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" required />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="EventType" class="form-label">Event Type</label>
                <select asp-for="EventType" class="form-select" asp-items="Html.GetEnumSelectList<EventType>()"></select>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="BannerImage" class="form-label">Event Banner Image</label>
            <input asp-for="BannerImage" type="file" class="form-control" accept="image/*" />
        </div>

        <button type="submit" class="btn btn-primary">Create Event & Upload Banner</button>
        <a asp-action="Dashboard" class="btn btn-secondary">Cancel</a>
    </form>
</div>