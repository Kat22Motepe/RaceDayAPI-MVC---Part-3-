@model RaceDay.MVC.ViewModels.EventListViewModel
@{
    ViewData["Title"] = Model.Name;
    var categories = ViewBag.Categories as List<RaceDay.MVC.ViewModels.CategoryViewModel>;
}

<div class="container mt-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow">
        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
        {
            <img src="@Model.BannerImageUrl" class="card-img-top" style="max-height: 400px; object-fit: cover;" alt="@Model.Name">
        }
        <div class="card-body">
            <h1 class="card-title">@Model.Name</h1>
            <h5 class="text-muted mb-4">@Model.EventDate.ToString("dddd, dd MMMM yyyy HH:mm")</h5>
            
            <div class="row mb-4">
                <div class="col-md-4"><strong>📍 Location:</strong> @Model.Location</div>
                <div class="col-md-4"><strong>🏃 Distance:</strong> @Model.DistanceKm km</div>
                <div class="col-md-4"><strong>🏷️ Type:</strong> @((RaceDay.MVC.ViewModels.EventType)Model.EventType)</div>
            </div>

            <hr />
            
            <h4>Select a Category to Enrol</h4>
            @if (categories != null && categories.Any())
            {
                <form asp-action="Enrol" method="post" class="mt-3">
                    <input type="hidden" name="eventId" value="@Model.Id" />
                    <div class="row align-items-end">
                        <div class="col-md-8">
                            <label class="form-label">Available Categories</label>
                            <select name="categoryId" class="form-select" required>
                                <option value="">-- Select a Category --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">
                                        @cat.Name 
                                        @(cat.DistanceKm.HasValue ? $"({cat.DistanceKm} km)" : "")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-success w-100">Enrol Now</button>
                        </div>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-warning">No categories have been created for this event yet.</div>
            }
        </div>
    </div>
    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back to Events</a>
    </div>
</div>